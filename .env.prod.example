# Copy this to .env.prod on the server and fill in real values
# NEVER commit .env.prod to git

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=retail_erp
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── Backend ───────────────────────────────────────────────────
DATABASE_URL=postgresql://erp_user:CHANGE_ME_STRONG_PASSWORD_HERE@db:5432/retail_erp

# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_RUN_openssl_rand_hex_32

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=https://clothflow.systems,https://www.clothflow.systems
