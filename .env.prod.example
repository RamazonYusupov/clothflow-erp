# Copy this to .env.prod on the server and fill in real values
# NEVER commit .env.prod to git

# PostgreSQL
POSTGRES_DB=retail_erp
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Backend
DATABASE_URL=postgresql://erp_user:CHANGE_ME_STRONG_PASSWORD@db:5432/retail_erp
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://YOUR_DROPLET_IP,https://yourdomain.com
