# Copy this to .env.prod on the server and fill in real values
# NEVER commit .env.prod to git

# ── PostgreSQL ────────────────────────────────────────────────
# Use ONLY letters, numbers, and underscores — no @ ! # $ % & chars
POSTGRES_DB=retail_erp
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=StrongPassword123
POSTGRES_HOST=db
POSTGRES_PORT=5432

# DATABASE_URL is now built automatically from the parts above.
# Only set this if you want to override (e.g. external managed DB).
# DATABASE_URL=postgresql://erp_user:StrongPassword123@db:5432/retail_erp

# ── Backend ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_RUN_openssl_rand_hex_32

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=https://clothflow.systems,https://www.clothflow.systems
